{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "description": "Testnet-only Ledger-funded agent payments with a scoped broker, durable accounting, authenticated evidence and a live operator workspace.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "preflight": "bash scripts/preflight.sh",
    "gateway": "node --experimental-strip-types packages/gateway/src/operator.ts",
    "service": "npm run dev -w @mandate/service",
    "seal:keys": "bash scripts/seal-keys.sh",
    "seal:hedera": "bash scripts/seal-hedera.sh",
    "setup:hedera": "node --experimental-strip-types scripts/provision-hedera.mjs",
    "check:ready": "node --experimental-strip-types scripts/check-ready.mjs",
    "check:mandate": "node --experimental-strip-types scripts/check-mandate.mjs",
    "accounts:status": "node --experimental-strip-types scripts/accounts-status.mjs",
    "wait:ledger": "bash scripts/wait-ledger.sh",
    "wait:eth": "bash scripts/wait-eth.sh",
    "ledger:reset": "node --experimental-strip-types scripts/ledger-reset.mjs",
    "ledger:check": "node --experimental-strip-types scripts/ledger-genuine-check.mjs",
    "e2e:stepup": "node --experimental-strip-types scripts/e2e-stepup.mjs",
    "probe:reputation": "node --experimental-strip-types scripts/probe-reputation.mjs",
    "e2e:graph-x402": "node --experimental-strip-types scripts/e2e-graph-x402.mjs",
    "e2e:paid-query": "node --experimental-strip-types scripts/e2e-paid-query.mjs",
    "e2e:upto": "node --experimental-strip-types scripts/e2e-upto.mjs",
    "e2e:poh": "node --experimental-strip-types scripts/e2e-poh.mjs",
    "e2e:substreams": "node --experimental-strip-types scripts/e2e-substreams.mjs",
    "hedera:associate-usdc": "node --experimental-strip-types scripts/hedera-associate-usdc.mjs",
    "e2e:graph-poi": "node --experimental-strip-types scripts/e2e-graph-x402.mjs",
    "e2e:hedera-batch": "node --experimental-strip-types scripts/e2e-hedera-batch.mjs",
    "provision:hcs": "node --experimental-strip-types scripts/provision-hcs.mjs",
    "e2e:audit": "node --experimental-strip-types scripts/e2e-audit.mjs",
    "uaid:register": "node --experimental-strip-types scripts/uaid-register.mjs",
    "treasury:topup": "node --experimental-strip-types scripts/treasury-topup.mjs",
    "live:gates": "node --experimental-strip-types scripts/live-gates.mjs",
    "setup:merchant": "node --experimental-strip-types scripts/provision-merchant.mjs",
    "setup:treasury": "node --experimental-strip-types scripts/provision-treasury.mjs",
    "e2e:payment": "node --experimental-strip-types scripts/e2e-payment.mjs",
    "e2e:verdicts": "node --experimental-strip-types scripts/e2e-verdicts.mjs",
    "boot": "node --experimental-strip-types scripts/stack.mjs",
    "e2e:hedera-exact": "node --experimental-strip-types scripts/e2e-payment.mjs",
    "e2e:hedera-usdc": "node --experimental-strip-types scripts/e2e-hedera-usdc.mjs",
    "e2e:erc7730": "node --experimental-strip-types scripts/e2e-erc7730.mjs",
    "e2e:erc7730-device": "node --experimental-strip-types scripts/e2e-erc7730-device.mjs",
    "facilitator": "npm run dev -w @mandate/facilitator",
    "mandate-service": "npm run dev -w @mandate/mandate-service",
    "mandate:keygen": "node --experimental-strip-types scripts/mandate-keygen.mjs",
    "facilitator:keygen": "node --experimental-strip-types scripts/facilitator-keygen.mjs",
    "mandate:open": "node --experimental-strip-types scripts/mandate-open.mjs",
    "mandate:refund": "node --experimental-strip-types scripts/mandate-refund.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "bash scripts/verify.sh",
    "device": "bash scripts/ring-watch.sh",
    "console": "node --experimental-strip-types packages/gateway/src/operator.ts",
    "console:open": "node scripts/open-console.mjs",
    "test:ui": "node --experimental-strip-types scripts/test-console.mjs",
    "agent": "node scripts/run-agent.mjs",
    "live:readiness": "node --experimental-strip-types scripts/live-preflight.mjs",
    "live:workspace": "node --experimental-strip-types scripts/live-workspace.mjs",
    "live:headless": "node --experimental-strip-types scripts/live-headless.mjs",
    "verify:descriptors": "node --experimental-strip-types scripts/e2e-erc7730.mjs",
    "mandate:reconcile": "node scripts/operator-task.mjs reconcile",
    "verify:linux": "bash scripts/clean-linux-verify.sh",
    "postinstall": "node scripts/apply-security-patches.mjs",
    "ledger:test-cal": "node scripts/ledger-test-cal.mjs",
    "ledger:test-context": "node scripts/probe-ledger-test-context.mjs",
    "agents:prepare": "node --experimental-strip-types scripts/prepare-agents.mjs",
    "agents:boot": "node --experimental-strip-types scripts/agent-stack.mjs",
    "agents:open": "MANDATE_CONSOLE_PORT=8420 MANDATE_OPERATOR_STATE=state/agents/operator node scripts/open-console.mjs",
    "test:agents:ui": "node --experimental-strip-types scripts/test-agent-run-ui.mjs",
    "test:agents:workspace": "node --experimental-strip-types scripts/test-agent-ui.mjs",
    "agents:recover-report": "node --experimental-strip-types scripts/recover-agent-report.mjs",
    "agents:verify-live": "node --experimental-strip-types scripts/verify-agent-live.mjs",
    "test:agents:live-report": "node --experimental-strip-types scripts/test-live-agent-report-ui.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "protobufjs@<8": "7.6.6",
    "protobufjs@>=8 <9": "8.8.0",
    "@grpc/grpc-js@>=1.12.0 <1.13.0": "1.12.7",
    "ws@>=8 <9": "8.21.3",
    "uuid@<11.1.1": "11.1.1",
    "bn.js@>=5 <6": "5.2.5",
    "decode-uri-component": "0.5.0",
    "file-type@>=13 <22": "21.3.4",
    "axios@>=1 <2": "1.20.0"
  }
}
