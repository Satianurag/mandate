{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "description": "A hardware-signed authorization envelope for AI agents. Approve once on your Ledger; the agent works at machine speed inside bounds it cannot widen.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "preflight": "bash scripts/preflight.sh",
    "gateway": "npm run dev -w @mandate/gateway",
    "service": "npm run dev -w @mandate/service",
    "seal:keys": "bash scripts/seal-keys.sh",
    "seal:hedera": "bash scripts/seal-hedera.sh",
    "setup:hedera": "node scripts/provision-hedera.mjs",
    "check:ready": "node scripts/check-ready.mjs",
    "check:mandate": "node scripts/check-mandate.mjs",
    "accounts:status": "node scripts/accounts-status.mjs",
    "wait:ledger": "bash scripts/wait-ledger.sh",
    "ledger:reset": "node scripts/ledger-reset.mjs",
    "ledger:check": "node scripts/ledger-genuine-check.mjs",
    "e2e:stepup": "node scripts/e2e-stepup.mjs",
    "probe:reputation": "node scripts/probe-reputation.mjs",
    "provision:hcs": "node scripts/provision-hcs.mjs",
    "e2e:audit": "node scripts/e2e-audit.mjs",
    "uaid:register": "node scripts/uaid-register.mjs",
    "treasury:topup": "node scripts/treasury-topup.mjs",
    "live:gates": "node scripts/live-gates.mjs",
    "e2e:payment": "node scripts/e2e-payment.mjs",
    "facilitator": "npm run dev -w @mandate/facilitator",
    "mandate-service": "npm run dev -w @mandate/mandate-service",
    "mandate:keygen": "node scripts/mandate-keygen.mjs",
    "facilitator:keygen": "node scripts/facilitator-keygen.mjs",
    "mandate:open": "node scripts/mandate-open.mjs",
    "mandate:refund": "node scripts/mandate-refund.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "bash scripts/verify.sh",
    "device": "bash scripts/ring-watch.sh"
  },
  "license": "MIT"
}
