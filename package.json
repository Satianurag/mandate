{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "description": "Ledger-approved autonomous x402 agents on Base mainnet with one authenticated workspace.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-strip-types scripts/start.mjs",
    "boot": "npm start",
    "console": "npm start",
    "gateway": "npm start",
    "agents:boot": "npm start",
    "console:open": "node scripts/open-console.mjs",
    "agents:open": "npm run console:open",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run build && npm test",
    "postinstall": "node scripts/apply-security-patches.mjs",
    "ledger:test-cal": "node scripts/ledger-test-cal.mjs",
    "facilitator": "node --experimental-strip-types packages/facilitator/src/index.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "protobufjs@<8": "7.6.6",
    "protobufjs@>=8 <9": "8.8.0",
    "@grpc/grpc-js@>=1.12.0 <1.13.0": "1.12.7",
    "ws@>=8 <9": "8.21.3",
    "uuid@<11.1.1": "11.1.1",
    "bn.js@>=5 <6": "5.2.5",
    "decode-uri-component": "0.5.0",
    "file-type@>=13 <22": "21.3.4",
    "axios@>=1 <2": "1.20.0"
  }
}
